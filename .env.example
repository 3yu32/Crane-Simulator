# Copy this file to .env (not committed) and configure ONE provider below
# to run the "style 3" AI-play backend (npm run ai-server).

# Which provider to call. "dashscope" (Qwen2.5-VL) or "gemini" (Gemini 2.5 Flash).
AI_PROVIDER=dashscope

# --- dashscope (used when AI_PROVIDER=dashscope) ---
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen2.5-vl-72b-instruct

# --- gemini (used when AI_PROVIDER=gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional:
# AI_SERVER_PORT=8787
