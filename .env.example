# Copy this file to .env (not committed) and fill in your Gemini API key
# to run the "style 3" AI-play backend (npm run ai-server).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides:
# GEMINI_MODEL=gemini-3.6-flash
# AI_SERVER_PORT=8787
# AI_LOG_DIR=./ai-runs   # where style-3 runs (and usage.jsonl) are saved

# Token cost estimate saved with each run (USD per 1M tokens).
# Verify current prices at https://ai.google.dev/pricing and adjust.
# GEMINI_PRICE_INPUT_PER_1M=0.30
# GEMINI_PRICE_OUTPUT_PER_1M=2.50
